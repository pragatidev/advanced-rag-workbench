# Advanced RAG workbench. Copy to .env. Never commit .env.
# Model ids live here and in rag/settings.py only.

# ---------------------------------------------------------------------------
# Default generate: Qwen Model Studio, Singapore International, OpenAI-compat.
# Official: https://www.alibabacloud.com/help/en/model-studio/compatibility-of-openai-with-dashscope
# ---------------------------------------------------------------------------
RAGBENCH_PROVIDER=qwen
RAGBENCH_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
RAGBENCH_API_KEY=
RAGBENCH_MODEL=qwen3.8-max
RAGBENCH_GENERATE=extractive

# Official Qwen env alias (same value as RAGBENCH_API_KEY):
DASHSCOPE_API_KEY=

# Preferred when you have a workspace id:
# RAGBENCH_API_BASE=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# US Virginia:
# RAGBENCH_API_BASE=https://dashscope-us.aliyuncs.com/compatible-mode/v1

# Taught three-var aliases. Settings reads these if RAGBENCH_* is empty.
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-max

# Turn Free Quota Only on in the Model Studio console (Singapore International).
# qwen3.8-max International: 1 million tokens, real-time inference only.

# ---------------------------------------------------------------------------
# Any OpenAI-compatible provider: set the three vars. No code change.
# ---------------------------------------------------------------------------
# OpenAI:
# RAGBENCH_PROVIDER=openai
# RAGBENCH_API_BASE=https://api.openai.com/v1
# RAGBENCH_API_KEY=
# RAGBENCH_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=          # UNVERIFIED this pass; set at record time

# Anthropic is Messages API, not OpenAI-compat by default. Use the Anthropic SDK or a gateway.
# RAGBENCH_PROVIDER=anthropic
# RAGBENCH_API_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Gemini / xAI / DeepSeek: OpenAI-compat where the vendor documents it.
# Exact 2026 chat ids UNVERIFIED this pass. Set via env. Do not invent them.
# Gemini:
# RAGBENCH_PROVIDER=gemini
# RAGBENCH_API_BASE=
# GEMINI_API_KEY=
# xAI:
# RAGBENCH_PROVIDER=xai
# RAGBENCH_API_BASE=
# XAI_API_KEY=
# DeepSeek:
# RAGBENCH_PROVIDER=deepseek
# RAGBENCH_API_BASE=
# DEEPSEEK_API_KEY=
# Model Studio also hosts deepseek-v4-pro and deepseek-v4-flash (official models page 2026-08-15).

# Embeddings:
EMBED_MODEL=nomic-embed-text
EMBED_MODEL_B=text-embedding-3-large
# text-embedding-3-large default 3072 dims; optional MRL dimensions=

# ---------------------------------------------------------------------------
# Local Ollama (https://docs.ollama.com/api/openai-compatibility)
# ---------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2:3b
# RAGBENCH_API_BASE=http://localhost:11434/v1
# RAGBENCH_API_KEY=ollama
# RAGBENCH_MODEL=llama3.2:3b
# EMBED_MODEL=nomic-embed-text
# Laptop-capable generate (official library): llama3.2:3b, llama3.2:1b, gemma3:4b, qwen2.5:3b, qwen2.5:7b, phi4-mini
# qwen3:8b: comfortable on 16 GB, tight on 8 GB
# Verified local embeds: nomic-embed-text, nomic-embed-text:v1.5, mxbai-embed-large, all-minilm

# ---------------------------------------------------------------------------
# Local LM Studio (https://lmstudio.ai/docs/developer/openai-compat)
# ---------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=              # whatever GGUF the student loaded. Do not hard-code.
# RAGBENCH_API_BASE=http://localhost:1234/v1
# RAGBENCH_API_KEY=lm-studio

RERANK_MODEL=BAAI/bge-reranker-base
WEB_SEARCH_ENABLED=false
